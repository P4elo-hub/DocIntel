# Корневой Settings
APP_NAME=llm-service
DEBUG=false
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000"]
REDIS_URL=redis://redis:6379/0
CACHE_TTL_SECONDS=3600

# LLMSettings (env_prefix="LLM_", nested через "__")
# Можно задать любой из двух вариантов (эквивалентны):
OPENAI_API_KEY=sk-example-key-here
# LLM__OPENAI_API_KEY=your-openai-api-key-here
LLM__BASE_URL=https://api.openai.com/v1
LLM__DEFAULT_MODEL=gpt-4o-mini
LLM__ENABLE_FALLBACK=true
LLM__REQUEST_TIMEOUT=30.0
LLM__MAX_RETRIES=3
# Доменная подсказка для Whisper (ASR). Пусто = встроенный список терминов
# (app/chat/media.py). Помогает от «OG→ОГЭ», «History Ops→Хистриопс».
# LLM__WHISPER_PROMPT=История операций (History Ops), Order Gateway (OG), Composite, БПХ, DCA, GET_TRADES
LLM__WHISPER_LANGUAGE=ru

# Observability (Phoenix + structlog)
PHOENIX_COLLECTOR_ENDPOINT=http://phoenix:6006/v1/traces
DOCINTEL__SERVICE_NAME=DocIntel
DOCINTEL__REQUEST_TIMEOUT_SECONDS=180
DOCINTEL__MAX_TOOL_ROUNDS=8
DOCINTEL__FALLBACK_BACKEND=ollama
DOCINTEL__FALLBACK_API_KEY=ollama
DOCINTEL__FALLBACK_BASE_URL=http://localhost:11434/v1
DOCINTEL__FALLBACK_MODEL=llama3.2:3b
DOCINTEL__DEEPSEEK_API_KEY=sk-example-key-here
# Fallback /chat и /chats: при ошибке OpenAI → DeepSeek (нужен ключ выше)
DOCINTEL__METHODOLOGY_DIR=feature-methodology-project
DOCINTEL__SHABLON_PATH=feature-methodology-project/shablon.md
DOCINTEL__DOCS_DIR=app/data/docs
DOCINTEL__KB_PATH=app/data/knowledge_base.txt
DOCINTEL__CONCURRENCY=5
DOCINTEL__SDK_TIMEOUT=30
DOCINTEL__BUSINESS_TIMEOUT=15
DOCINTEL__MAX_TOKENS=512

# Security (Б3.8)
SECURITY_ENABLED=true
RATE_LIMIT_PER_MIN=30

# Chat history (M4.1)
# Docker Compose подставляет postgres://...@postgres:5432 автоматически
CHAT_REPOSITORY=postgres
CHAT_STORAGE_DIR=./var/chats
CHAT_CONTEXT_STRATEGY=sliding
CHAT_CONTEXT_WINDOW=10
CHAT_MODEL_CONTEXT_WINDOW=128000
CHAT_RESPONSE_TOKENS=1024
CHAT_SAFETY_MARGIN=256
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/llm_service

# === Telegram bot ===
# Токен от @BotFather — вставьте сюда (файл .env в корне проекта, рядом с compose.yaml).
# После изменения: docker compose up --build  или  uv run python -m bot
BOT_TOKEN=
BACKEND_URL=http://app:8000
# Ваш Telegram user id (узнать: @userinfobot). Через запятую для нескольких админов.
BOT_ADMIN_IDS=

# === Service-to-service (POST /notify: backend → bot) ===
INTERNAL_TOKEN=change-me-with-openssl-rand-hex-32
BOT_URL=http://bot:9000
BOT_API_PORT=9000

# === Admin / production ===
ADMIN_TOKEN=change-me-with-openssl-rand-hex-32
# Telegram chat_id админ-группы для alert drain (бот шлёт алерты сюда). Пусто = отключено.
ADMIN_CHAT_ID=
MODERATION_USE_OPENAI=true
RATE_LIMIT_MESSAGES_PER_MIN=15

# === Qdrant (M5) ===
# URL до Qdrant. В docker-compose сети — http://qdrant:6333, локально — http://localhost:6333.
QDRANT_URL=http://qdrant:6333
# Опционально. Если пусто — Qdrant запускается без аутентификации (dev-режим).
QDRANT_API_KEY=
# Имя коллекции для документов проекта.
QDRANT_COLLECTION=documents
# Размерность вектора embedding-модели:
#   1536 — text-embedding-3-small (OpenAI)
#   3072 — text-embedding-3-large (OpenAI)
EMBEDDING_DIM=1536
EMBEDDING_MODEL=text-embedding-3-small

# === RAG (LlamaIndex) ===
# Встроенный RAG в чат (вариант C): чат ищет в базе знаний и отвечает с цитатами.
# false — обычный чат без обращения к базе знаний.
CHAT_RAG_ENABLED=true
# Корпус для индексации (10+ документов предметной области).
RAG_DATA_DIR=data/rag-block-03
# Коллекция LlamaIndex (прод-путь /rag/query) и отдельная для bare-metal сравнения.
RAG_COLLECTION=rag_block_03
RAG_COLLECTION_BARE=rag_block_03_bare
# LLM для генерации ответа по контексту (отдельно от LLM__DEFAULT_MODEL обычного /chat).
RAG_LLM_MODEL=gpt-5.4-mini
# Сколько чанков отдаём в контекст и параметры нарезки.
RAG_TOP_K=3
# Крупные чанки: раздел фичи (AS IS / TO BE / интеграции) целиком, а не по предложениям.
RAG_CHUNK_SIZE=1024
RAG_CHUNK_OVERLAP=128
# Батч embeddings для OpenAI (лимит ~300k токенов/запрос; на больших .md держите 16–32).
RAG_EMBED_BATCH_SIZE=32
# Документов за один прогон pipeline (прогресс в логах, частичная запись в Qdrant).
RAG_INGEST_DOC_BATCH_SIZE=25
# Если top-1 score ниже порога — считаем, что ответа в корпусе нет.
RAG_SCORE_THRESHOLD=0.3
# Корпоративный RAG: достаём широко, оставляем top_n лучших.
# top_k=10: с reranker на CPU 25 кандидатов давали ~39с/запрос. 10 — быстрее.
RAG_RETRIEVE_TOP_K=10
# Меньше чанков в контексте = меньше шума (таблицы логов/оглавления) и быстрее ответ.
RAG_RERANK_TOP_N=5
# Резать markdown по заголовкам (## AS IS / ## TO BE / ## Интеграции), а не по предложениям.
RAG_CHUNK_BY_HEADINGS=true
# Не индексировать помеченные deprecated-документы (напр. «Фронт Старая Лента»).
RAG_SKIP_DEPRECATED=true
# Реранкер (cross-encoder) — тяжёлая зависимость (extra `retrieval`).
# ВЫКЛЮЧЕН по умолчанию: веса bge-reranker-v2-m3 (~2.2 ГБ) качаются с HF при
# первом build() и блокируют готовность RAG на несколько минут (кэш HF внутри
# контейнера теряется при пересборке). Как включить надёжно — см. docs/rag.md
# (том для HF-кэша + предзагрузка модели). Dense-поиск + reranker=false работает сразу.
RAG_USE_RERANKER=false
RAG_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# Гибридный поиск ВЫКЛЮЧЕН: llama-index-vector-stores-qdrant 0.8.8 в hybrid-режиме
# шлёт устаревший search_batch без имени вектора → Qdrant 400. Починка требует
# qdrant-client>=1.16 + интеграцию >=0.10 (сейчас пин <1.16). Включать только
# после этого апгрейда (и полного reindex, чтобы создать sparse-вектора).
RAG_USE_HYBRID=false
RAG_SPARSE_MODEL=Qdrant/bm25
# Фильтр visibility="internal" до ретрива (только для корпуса, проиндексированного через IngestionService).
RAG_RESTRICT_TO_INTERNAL=false

# === Phoenix-трейсинг LlamaIndex (опционально, группа `tracing`) ===
# По умолчанию выключено. Включить: PHOENIX_ENABLED=true + uv sync --extra tracing.
PHOENIX_ENABLED=false

# === Оценка качества RAGAS (опционально, группа `eval`) ===
# Судья метрик отделён от RAG-LLM (RAG_LLM_MODEL): роли разные.
# Нужен только для scripts/run_eval.py и generate_testset.py.
# ANTHROPIC_API_KEY=sk-ant-...
EVAL_JUDGE_PROVIDER=anthropic
EVAL_JUDGE_MODEL=claude-sonnet-4-6
