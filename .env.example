# Корневой Settings
APP_NAME=llm-service
DEBUG=false
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000"]
REDIS_URL=redis://redis:6379/0
CACHE_TTL_SECONDS=3600

# LLMSettings (env_prefix="LLM_", nested через "__")
# Можно задать любой из двух вариантов (эквивалентны):
OPENAI_API_KEY=sk-example-key-here
# LLM__OPENAI_API_KEY=your-openai-api-key-here
LLM__DEFAULT_MODEL=gpt-4o-mini
LLM__REQUEST_TIMEOUT=30.0
LLM__MAX_RETRIES=3

# Observability (Phoenix + structlog)
PHOENIX_COLLECTOR_ENDPOINT=http://phoenix:6006/v1/traces
DOCINTEL__SERVICE_NAME=DocIntel
DOCINTEL__REQUEST_TIMEOUT_SECONDS=180
DOCINTEL__MAX_TOOL_ROUNDS=8
DOCINTEL__FALLBACK_BACKEND=ollama
DOCINTEL__FALLBACK_API_KEY=ollama
DOCINTEL__FALLBACK_BASE_URL=http://localhost:11434/v1
DOCINTEL__FALLBACK_MODEL=llama3.2:3b
DOCINTEL__DEEPSEEK_API_KEY=sk-example-key-here
DOCINTEL__METHODOLOGY_DIR=feature-methodology-project
DOCINTEL__SHABLON_PATH=feature-methodology-project/shablon.md
DOCINTEL__DOCS_DIR=app/data/docs
DOCINTEL__KB_PATH=app/data/knowledge_base.txt
DOCINTEL__CONCURRENCY=5
DOCINTEL__SDK_TIMEOUT=30
DOCINTEL__BUSINESS_TIMEOUT=15
DOCINTEL__MAX_TOKENS=512

# Security (Б3.8)
SECURITY_ENABLED=true
RATE_LIMIT_PER_MIN=30
