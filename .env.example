# Корневой Settings
APP_NAME=llm-service
DEBUG=false
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000"]
REDIS_URL=redis://redis:6379/0
CACHE_TTL_SECONDS=3600

# LLMSettings (env_prefix="LLM_", nested через "__")
# Можно задать любой из двух вариантов (эквивалентны):
OPENAI_API_KEY=sk-example-key-here
# LLM__OPENAI_API_KEY=your-openai-api-key-here
LLM__BASE_URL=https://api.openai.com/v1
LLM__DEFAULT_MODEL=gpt-4o-mini
LLM__ENABLE_FALLBACK=true
LLM__REQUEST_TIMEOUT=30.0
LLM__MAX_RETRIES=3

# Observability (Phoenix + structlog)
PHOENIX_COLLECTOR_ENDPOINT=http://phoenix:6006/v1/traces
DOCINTEL__SERVICE_NAME=DocIntel
DOCINTEL__REQUEST_TIMEOUT_SECONDS=180
DOCINTEL__MAX_TOOL_ROUNDS=8
DOCINTEL__FALLBACK_BACKEND=ollama
DOCINTEL__FALLBACK_API_KEY=ollama
DOCINTEL__FALLBACK_BASE_URL=http://localhost:11434/v1
DOCINTEL__FALLBACK_MODEL=llama3.2:3b
DOCINTEL__DEEPSEEK_API_KEY=sk-example-key-here
# Fallback /chat и /chats: при ошибке OpenAI → DeepSeek (нужен ключ выше)
DOCINTEL__METHODOLOGY_DIR=feature-methodology-project
DOCINTEL__SHABLON_PATH=feature-methodology-project/shablon.md
DOCINTEL__DOCS_DIR=app/data/docs
DOCINTEL__KB_PATH=app/data/knowledge_base.txt
DOCINTEL__CONCURRENCY=5
DOCINTEL__SDK_TIMEOUT=30
DOCINTEL__BUSINESS_TIMEOUT=15
DOCINTEL__MAX_TOKENS=512

# Security (Б3.8)
SECURITY_ENABLED=true
RATE_LIMIT_PER_MIN=30

# Chat history (M4.1)
# Docker Compose подставляет postgres://...@postgres:5432 автоматически
CHAT_REPOSITORY=postgres
CHAT_STORAGE_DIR=./var/chats
CHAT_CONTEXT_STRATEGY=sliding
CHAT_CONTEXT_WINDOW=10
CHAT_MODEL_CONTEXT_WINDOW=128000
CHAT_RESPONSE_TOKENS=1024
CHAT_SAFETY_MARGIN=256
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/llm_service

# === Telegram bot ===
# Токен от @BotFather — вставьте сюда (файл .env в корне проекта, рядом с compose.yaml).
# После изменения: docker compose up --build  или  uv run python -m bot
BOT_TOKEN=
BACKEND_URL=http://app:8000
# Ваш Telegram user id (узнать: @userinfobot). Через запятую для нескольких админов.
BOT_ADMIN_IDS=

# === Service-to-service (POST /notify: backend → bot) ===
INTERNAL_TOKEN=change-me-with-openssl-rand-hex-32
BOT_URL=http://bot:9000
BOT_API_PORT=9000

# === Admin / production ===
ADMIN_TOKEN=change-me-with-openssl-rand-hex-32
# Telegram chat_id админ-группы для alert drain (бот шлёт алерты сюда). Пусто = отключено.
ADMIN_CHAT_ID=
MODERATION_USE_OPENAI=true
RATE_LIMIT_MESSAGES_PER_MIN=15
