{
  "rest": {
    "RestGenerator": {
      "name": "diploma-fastapi-features",
      "uri": "http://localhost:8000/features/chat",
      "method": "post",
      "headers": {"Content-Type": "application/json"},
      "req_template_json_object": {
        "messages": [{"role": "user", "content": "$INPUT"}],
        "model": "gpt-4o-mini",
        "temperature": 0.7
      },
      "response_json": true,
      "response_json_field": "content",
      "request_timeout": 60
    }
  }
}
